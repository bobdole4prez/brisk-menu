#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

DEB_BUILD_PARALLEL = 1

# Wayland (gtk-layer-shell) is Linux-only
ifeq ($(DEB_HOST_ARCH_OS),linux)
WAYLAND_OPT = -Dwayland=enabled
else
WAYLAND_OPT = -Dwayland=disabled
endif

# mate-panel 1.29 changed the applet ABI (libmate-panel-applet-4.so.2 and a
# larger MatePanelAppletClass), so a build only works with the mate-panel
# series it was built against. Label the binary version and limit the
# mate-panel dependency to match the mate-panel found at build time.
MATE_PANEL_VERSION := $(shell pkg-config --modversion libmatepanelapplet-4.0)
ifeq ($(shell dpkg --compare-versions "$(MATE_PANEL_VERSION)" ge 1.29 && echo new),new)
MATE_SERIES  = mate1.29
MATE_DEPENDS = mate-panel (>= 1.29)
else
MATE_SERIES  = mate1.28
MATE_DEPENDS = mate-panel (>= 1.27), mate-panel (<< 1.29)
endif

# use the NEWS file as upstream ChangeLog...
DEB_INSTALL_DOCS_ALL = README.md

%:
	dh $@ --without autoreconf --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
	        --libexecdir=/usr/lib/$(DEB_HOST_MULTIARCH)/brisk-menu/ \
	        -Din-process=true \
	        $(WAYLAND_OPT)

override_dh_gencontrol:
	dh_gencontrol -- -v$(DEB_VERSION)+$(MATE_SERIES) '-Vmate:Depends=$(MATE_DEPENDS)'

common-binary-post-install-arch:: list-missing

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
